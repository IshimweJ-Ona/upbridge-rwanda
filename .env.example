# Public Cloudinary configuration (safe for frontend builds; NEVER add API secrets here)
VITE_CLOUDINARY_CLOUD_NAME=vbzq5ssu
VITE_CLOUDINARY_UPLOAD_PRESET=upbridge_public_images

# Optional free external Node.js/Express backend URL for privileged Admin SDK operations
# (Leave unset for standalone Firebase Spark + local Admin SDK CLI script workflow)
ADMIN_API_BASE_URL=

# Firebase client configuration (optional when android/app/google-services.json or
# ios/Runner/GoogleServiceInfo.plist is present locally; required for Web or
# running without native config via `flutter run --dart-define-from-file=.env`).
# Copy this file to `.env` (gitignored) and obtain values from your team lead
# or Firebase Console for project `upridge-rwanda-dev`.
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MEASUREMENT_ID=
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_CLIENT_ID=
FIREBASE_IOS_BUNDLE_ID=com.example.upbridge
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
