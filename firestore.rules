// Requires verified Firebase email claims; feature writes stay closed until reviewed.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Roles are trusted only when provisioned as Firebase Auth custom claims.
    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function owns(field) {
      return signedIn() && resource.data[field] == request.auth.uid;
    }

    function isGenericCollection(collection) {
      return !(collection in [
        'users', 'auditLogs', 'appSettings', 'learningPaths',
        'learningTasks', 'opportunities'
      ]);
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'youth'
        && request.resource.data.accountStatus == 'active';
      allow update: if isAdmin() || (signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoUrl', 'phone', 'interests', 'learningGoal',
          'onboarded', 'updatedAt'
        ]));
      allow delete: if isAdmin();
    }

    match /checkIns/{checkInId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'monthKey', 'usefulness', 'applied', 'changeNote', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.monthKey is string
        && request.resource.data.monthKey.matches('^\\d{4}-(0[1-9]|1[0-2])$')
        && checkInId == request.auth.uid + '_' + request.resource.data.monthKey
        && request.resource.data.usefulness is int
        && request.resource.data.usefulness >= 1
        && request.resource.data.usefulness <= 5
        && request.resource.data.applied is bool
        && request.resource.data.changeNote is string
        && request.resource.data.changeNote.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt'])
        && request.resource.data.isRead == true
        && request.resource.data.readAt == request.time;
    }

    // ── Mentorship (owner: Boaz) ──
    // Mirrors MentorSessionStatus.canTransition and SessionModel in the app.

    function mentorProfile(mentorId) {
      return get(/databases/$(database)/documents/mentorProfiles/$(mentorId));
    }

    function isBookableMentor(mentorId) {
      return exists(/databases/$(database)/documents/mentorProfiles/$(mentorId))
        && mentorProfile(mentorId).data.get('verified', false) == true
        && mentorProfile(mentorId).data.get('accepting', true) != false;
    }

    function isText(value, maxSize) {
      return value is string && value.size() <= maxSize;
    }

    function isMeetingLink(value) {
      return value is string && value.size() <= 300
        && (value.size() == 0 || value.matches('^https://[^\\s]+$'));
    }

    function sessionChangeOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /mentorSessions/{sessionId} {
      allow read: if signedIn()
        && (resource.data.requesterId == request.auth.uid
          || resource.data.mentorId == request.auth.uid);

      // A youth requests a session with a verified mentor who is accepting.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'requesterId', 'requesterName', 'mentorId', 'mentorName', 'topic',
          'note', 'startsAt', 'durationMinutes', 'mode', 'status',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'requesterId', 'mentorId', 'topic', 'startsAt', 'durationMinutes',
          'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.mentorId is string
        && request.resource.data.mentorId != request.auth.uid
        && isBookableMentor(request.resource.data.mentorId)
        && request.resource.data.status == 'requested'
        && isText(request.resource.data.topic, 80)
        && request.resource.data.topic.size() > 0
        && isText(request.resource.data.get('note', ''), 500)
        && isText(request.resource.data.get('requesterName', ''), 100)
        && isText(request.resource.data.get('mentorName', ''), 100)
        && isText(request.resource.data.get('mode', ''), 40)
        && request.resource.data.startsAt is timestamp
        && request.resource.data.startsAt > request.time
        && request.resource.data.durationMinutes is int
        && request.resource.data.durationMinutes >= 1
        && request.resource.data.durationMinutes <= 120
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && request.resource.data.updatedAt == request.time
        && (
          // Youth: cancel a pending or confirmed session.
          (resource.data.requesterId == request.auth.uid
            && sessionChangeOnly(['status', 'updatedAt'])
            && resource.data.status in ['requested', 'confirmed']
            && request.resource.data.status == 'cancelled')
          ||
          // Mentor: answer a request, then complete or cancel it.
          (resource.data.mentorId == request.auth.uid
            && sessionChangeOnly(['status', 'meetingLink', 'updatedAt'])
            && ((resource.data.status == 'requested'
                  && request.resource.data.status in ['confirmed', 'declined'])
              || (resource.data.status == 'confirmed'
                  && request.resource.data.status in ['completed', 'cancelled']))
            && (request.resource.data.get('meetingLink', '') == resource.data.get('meetingLink', '')
              || (request.resource.data.status == 'confirmed'
                  && isMeetingLink(request.resource.data.meetingLink))))
        );

      // A youth may withdraw a request nobody has answered yet.
      allow delete: if signedIn()
        && resource.data.requesterId == request.auth.uid
        && resource.data.status == 'requested';
    }

    // Profiles are created and verified by admins. A mentor edits only their
    // availability, meeting link and whether they accept new mentees.
    match /mentorProfiles/{mentorId} {
      allow update: if signedIn()
        && request.auth.uid == mentorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'meetingLink', 'menteeLimit', 'availabilityWindows', 'accepting',
          'availability', 'openSlots', 'updatedAt'
        ])
        && isMeetingLink(request.resource.data.get('meetingLink', ''))
        && request.resource.data.get('menteeLimit', 5) is int
        && request.resource.data.get('menteeLimit', 5) >= 1
        && request.resource.data.get('menteeLimit', 5) <= 10
        && request.resource.data.get('availabilityWindows', []) is list
        && request.resource.data.get('availabilityWindows', []).size() <= 21
        && request.resource.data.get('accepting', false) is bool
        && isText(request.resource.data.get('availability', ''), 1500)
        && request.resource.data.get('openSlots', []) is list
        && request.resource.data.get('openSlots', []).size() <= 300
        && request.resource.data.updatedAt == request.time;
    }

    match /{catalog}/{documentId} {
      allow read: if catalog in ['learningPaths', 'learningTasks', 'opportunities']
        && resource.data.status == 'published' && signedIn();
      allow write: if catalog in ['learningPaths', 'learningTasks', 'opportunities']
        && isAdmin();
    }

    match /{collection}/{documentId} {
      allow read: if isGenericCollection(collection)
        && (isAdmin()
          || (collection == 'mentorProfiles' && signedIn())
          || owns('userId')
          || owns('ownerId')
          || owns('requesterId'));
      // Feature-owned writes stay closed until their field validation and
      // permitted status transitions are reviewed with each feature owner.
      allow create, update, delete: if isGenericCollection(collection)
        && isAdmin();
    }

    match /auditLogs/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /appSettings/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
