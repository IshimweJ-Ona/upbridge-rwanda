// Requires verified Firebase email claims and enforces per-feature ownership and state rules.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Roles are trusted only when provisioned as Firebase Auth custom claims.
    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isMentor() {
      return signedIn() && request.auth.token.role == 'mentor';
    }

    function owns(field) {
      return signedIn() && resource.data[field] == request.auth.uid;
    }

    function isGenericCollection(collection) {
      return !(collection in [
        'users',
        'mentorProfiles',
        'mentorSessions',
        'applications',
        'checkIns',
        'notifications',
        'auditLogs',
        'appSettings',
        'learningPaths',
        'learningTasks',
        'opportunities'
      ]);
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'youth'
        && request.resource.data.accountStatus == 'active';
      allow update: if isAdmin() || (signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoUrl', 'phone', 'interests', 'learningGoal',
          'onboarded', 'updatedAt'
        ]));
      allow delete: if isAdmin();
    }

    match /mentorProfiles/{mentorId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isMentor()
        && request.auth.uid == mentorId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'meetingLink', 'menteeLimit', 'availabilityWindows',
          'accepting', 'availability', 'openSlots', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time);
    }

    match /mentorSessions/{sessionId} {
      allow read: if isAdmin() || (signedIn()
        && (resource.data.requesterId == request.auth.uid
          || resource.data.mentorId == request.auth.uid));
      allow create: if signedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.keys().hasOnly([
          'requesterId', 'requesterName', 'mentorId', 'mentorName',
          'topic', 'note', 'startsAt', 'durationMinutes', 'mode',
          'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() || (signedIn() && (
        (resource.data.requesterId == request.auth.uid
          && resource.data.status in ['requested', 'confirmed']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'cancelled'
          && request.resource.data.updatedAt == request.time)
        || (isMentor()
          && resource.data.mentorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'meetingLink', 'updatedAt'
          ])
          && ((resource.data.status == 'requested'
                && request.resource.data.status in ['confirmed', 'declined'])
              || (resource.data.status == 'confirmed'
                && request.resource.data.status in ['completed', 'cancelled']))
          && request.resource.data.updatedAt == request.time)
      ));
      allow delete: if isAdmin() || (signedIn()
        && resource.data.requesterId == request.auth.uid
        && resource.data.status == 'requested');
    }

    match /applications/{applicationId} {
      allow read: if isAdmin() || owns('userId');
      allow create: if signedIn()
        && applicationId == request.auth.uid + '_' + request.resource.data.opportunityId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'sent'
        && request.resource.data.keys().hasOnly([
          'userId', 'userName', 'opportunityId', 'projectIds',
          'note', 'status', 'ref', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.projectIds is list
        && request.resource.data.projectIds.size() >= 1
        && request.resource.data.note is string
        && request.resource.data.note.size() >= 60
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() || (signedIn()
        && resource.data.userId == request.auth.uid
        && (
          (resource.data.status in ['sent', 'underReview']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && request.resource.data.status == 'withdrawn'
            && request.resource.data.updatedAt == request.time)
          || (resource.data.status == 'withdrawn'
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.opportunityId == resource.data.opportunityId
            && request.resource.data.status == 'sent'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'userName', 'projectIds', 'note', 'status', 'ref', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.projectIds is list
            && request.resource.data.projectIds.size() >= 1
            && request.resource.data.note is string
            && request.resource.data.note.size() >= 60
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time)
        ));
      allow delete: if isAdmin();
    }

    match /checkIns/{checkInId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'monthKey', 'usefulness', 'applied', 'changeNote', 'createdAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.monthKey is string
        && request.resource.data.monthKey.matches('^\\d{4}-(0[1-9]|1[0-2])$')
        && checkInId == request.auth.uid + '_' + request.resource.data.monthKey
        && request.resource.data.usefulness is int
        && request.resource.data.usefulness >= 1
        && request.resource.data.usefulness <= 5
        && request.resource.data.applied is bool
        && request.resource.data.changeNote is string
        && request.resource.data.changeNote.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, delete: if false;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt'])
        && request.resource.data.isRead == true
        && request.resource.data.readAt == request.time;
    }

    match /{catalog}/{documentId} {
      allow read: if catalog in ['learningPaths', 'learningTasks', 'opportunities']
        && resource.data.status == 'published' && signedIn();
      allow write: if catalog in ['learningPaths', 'learningTasks', 'opportunities']
        && isAdmin();
    }

    match /{collection}/{documentId} {
      allow read: if isGenericCollection(collection)
        && (isAdmin()
          || owns('userId')
          || owns('ownerId')
          || owns('requesterId'));
      // Unfinalized feature writes (learning/portfolio) stay closed until
      // their field validation and permitted transitions are reviewed.
      allow create, update, delete: if isGenericCollection(collection)
        && isAdmin();
    }

    match /auditLogs/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /appSettings/{documentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
